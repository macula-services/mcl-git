#!/bin/sh
# git-remote-mesh: git runs this, as `git-remote-mesh <remote> <url>', for
# every mesh://<realm>/<repo_id> URL. Put this directory on PATH (the image
# does) and `git clone mesh://io.macula/repo-...' works.
#
# It runs the release's own ERTS with nothing started but what the helper
# starts, and it keeps stdout for git: stdout IS the remote-helper protocol,
# so every log line goes to stderr.
#
# The environment it needs (see git_remote_macula):
#   MACULA_STATION_SEEDS, MACULA_STATION_NODE_IDS, MCL_GIT_REALM_KEY
# and it uses this machine's one stored macula identity, which is who owns
# the repositories you initiate and who may push to them.
set -eu
SELF=$(readlink -f "$0")
ROOT=$(dirname "$(dirname "$SELF")")
VSN=$(cut -d' ' -f2 "$ROOT/releases/start_erl.data")
ERTS_VSN=$(cut -d' ' -f1 "$ROOT/releases/start_erl.data")
BINDIR="$ROOT/erts-$ERTS_VSN/bin"
export ROOTDIR="$ROOT" BINDIR EMU=beam PROGNAME=git-remote-mesh
exec "$BINDIR/erlexec" -noshell -boot "$ROOT/releases/$VSN/start_clean" \
    -pa "$ROOT"/lib/*/ebin \
    -macula crypto_profile pq_hybrid \
    -kernel logger_level warning \
    -kernel logger '[{handler,default,logger_std_h,#{config=>#{type=>standard_error}}}]' \
    -run git_remote_mesh main -extra "$@"
