%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_git.
%%
%% Git over the mesh: bare repositories held by this node, cloned, fetched and
%% pushed through `git upload-pack' / `git receive-pack' behind org-namespaced
%% mesh procedures. Recuperated from hecate-daemon's git-over-mesh apps
%% (clone verified end to end there on 2026-04-21, one machine) onto macula 12.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% mcl_git_service exports store_id/0 + data_dir/0, so mcl_om:boot/1 opens
    %% the store and its evoq subscription before start/1 runs. 0.27: no
    %% barrel_docdb, so no rocksdb anywhere in this service; and a boot claim
    %% labelled with MCL_SERVICE_NAME / MCL_BOX, so the realm's operator sees
    %% which box is asking. 0.28: handler_timeout_ms per capability (macula
    %% 12.2), and a publisher that fails no longer kills the process that
    %% published.
    {mcl_om, "~> 0.28"},
    %% Declared directly because the desks implement macula's response and
    %% publisher behaviours themselves. 12.2.1: a handler's own refusal
    %% (not_owner, not_found, ...) reaches the caller as handler_error with
    %% its reason, not as unknown_error (macula#28).
    {macula, ">= 12.2.1 and < 13.0.0"},
    %% 1.24 marks a restart's replayed events, so the fact-publishing handler
    %% declares replay_policy() -> skip instead of re-announcing every push
    %% on every boot.
    {evoq, "~> 1.24"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

{dialyzer, [
    {warnings, [unknown]},
    {plt_extra_apps, [evoq, macula, mcl_om, reckon_gater]}
]}.

{relx, [
    %% git_remote_mesh is LOADED, not started: it is the client git runs, from
    %% the same release, through bin/git-remote-mesh and bin/git-mesh (rel/overlay).
    {release, {mcl_git, "0.1.0"}, [guide_repo_lifecycle, project_repos, query_repos,
                                   serve_git_over_mesh, mcl_git, sasl,
                                   {git_remote_mesh, load}]},
    {overlay, [{copy, "rel/overlay/bin/git-remote-mesh", "bin/git-remote-mesh"},
               {copy, "rel/overlay/bin/git-mesh", "bin/git-mesh"}]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    %% meck stands in for the store and the mesh where a test needs to see
    %% exactly what a desk hands on.
    {test, [{deps, [{meck, "~> 1.2"}]},
            {eunit_opts, [{sys_config, "./config/test.sys.config"}]}]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
