%% The test environment: the crypto profile macula reads at start, and the
%% suite's OWN node identity. Unset, macula 12 reads (and on a fresh machine
%% writes) ~/.local/share/macula/identity.key, the identity of whoever runs
%% the tests.
[
    {kernel, [{logger_level, warning}]},
    {macula, [
        {node_identity_path, "_build/test/node_identity.key"},
        {crypto_profile, pq_hybrid}
    ]}
].
